# 開催日 21:00 機能動作テスト → テストWebhook報告
# CRON_TZ で JST を明示（OS TZ に依存しない）
CRON_TZ=Asia/Tokyo
# race_day_stop（通常 20:00）の後に動かす。stop スクリプトには埋め込まない。
0 21 * * * cd /opt/yokuumakun_auto-x && TZ=Asia/Tokyo /opt/yokuumakun_auto-x/.venv/bin/python /opt/yokuumakun_auto-x/server_deployment/race_day_evening_functional_test.py >> /opt/yokuumakun_auto-x/logs/race_day_evening_functional_test_cron.log 2>&1
