[Unit]
Description=Timer: publish public snapshot after morning bulk / pre-race if stale

[Timer]
# 朝一斉〜最終レース帯まで。本日成功パターン（発走15分前更新）の取りこぼしを拾う
OnCalendar=*-*-* 05:30:00
OnCalendar=*-*-* 06:00:00
OnCalendar=*-*-* 06:30:00
OnCalendar=*-*-* 07:00:00
OnCalendar=*-*-* 07:30:00
OnCalendar=*-*-* 08:00:00
OnCalendar=*-*-* 08:30:00
OnCalendar=*-*-* 09:00:00
OnCalendar=*-*-* 09:30:00
OnCalendar=*-*-* 10:00:00
OnCalendar=*-*-* 10:30:00
OnCalendar=*-*-* 11:00:00
OnCalendar=*-*-* 11:30:00
OnCalendar=*-*-* 12:00:00
OnCalendar=*-*-* 12:30:00
OnCalendar=*-*-* 13:00:00
OnCalendar=*-*-* 13:30:00
OnCalendar=*-*-* 14:00:00
OnCalendar=*-*-* 14:30:00
OnCalendar=*-*-* 15:00:00
OnCalendar=*-*-* 15:30:00
OnCalendar=*-*-* 16:00:00
OnCalendar=*-*-* 16:30:00
OnCalendar=*-*-* 17:00:00
OnCalendar=*-*-* 17:30:00
OnCalendar=*-*-* 18:00:00
OnCalendar=*-*-* 18:30:00
OnCalendar=*-*-* 19:00:00
Persistent=true
Unit=yokuum-morning-publish-watch.service

[Install]
WantedBy=timers.target
