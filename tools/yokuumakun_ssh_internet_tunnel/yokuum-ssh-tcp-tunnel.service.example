[Unit]
Description=yokuumakun SSH TCP internet tunnel (bore.pub)
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
User=tn
WorkingDirectory=/opt/yokuumakun_auto-x
Environment=YOKUMAKUN_ROOT=/opt/yokuumakun_auto-x
Environment=TZ=Asia/Tokyo
Environment=SSH_TUNNEL_USER=tn
# .env は publish_ssh_endpoint.py が dotenv で読む。
# systemd EnvironmentFile に渡すと .env のシェル構文で unit 起動失敗しやすいので使わない。
ExecStart=/bin/bash /opt/yokuumakun_auto-x/server_deployment/ssh_tcp_tunnel.sh
Restart=always
RestartSec=8
KillMode=process

[Install]
WantedBy=multi-user.target
